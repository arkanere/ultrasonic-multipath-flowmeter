# Compiled object files
*.o
*.a
*.so

# Executable (anchored one level down, so it is the binary in each language
# directory and not, say, haskell-language/src/Flowmeter/ -- git is
# case-insensitive on macOS and a bare `flowmeter` pattern matches that dir)
/*/flowmeter

# ...but go-language/flowmeter/ is the Go package directory, not a binary, and
# the pattern above would have swallowed it. A trailing slash matches only
# directories, so this re-includes it without un-ignoring any executable.
!/*/flowmeter/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Build artifacts
*.out

# Clojure/Leiningen
target/
classes/
.lein-failures
.lein-repl-history
.lein-plugins/
*.jar
pom.xml

# Rust/Cargo
# (target/ is already ignored above, shared with Leiningen)
**/*.rs.bk

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Node.js
node_modules/
npm-debug.log*

# FreeBASIC / Free Pascal
*.ppu
*.ppl
*.compiled

# Elixir
_build/
deps/
*.ez
.elixir_ls/

# Haskell
dist-newstyle/
dist/
*.hi

# Emacs Lisp
*.elc

# Common Lisp
*.fasl
